# Telegram (required to send)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Calendars (secret iCal URLs, optional). For several calendars, put one URL
# per line in gcal_urls.txt and pass it as GCAL_ICS_URLS (see README).
GCAL_ICS_URL=

# Location (example values)
LATITUDE=48.8566
LONGITUDE=2.3522
CITY_NAME=Paris
TIMEZONE=Europe/Paris

# Optional sections (true/false)
ENABLE_QURAN=true
ENABLE_SELF_TALK=true
ENABLE_WORD=true
ENABLE_EVENING=true
ENABLE_EVENING_VERSE=true
ENABLE_NIGHT_NOTE=true
ENABLE_WEEKLY=true

# Optional
DEADLINES_DAYS=14
DEADLINES_FILE=deadlines.json
WORDS_FILE=words.json
SELF_TALK_FILE=self_talk.json
NIGHT_NOTES_FILE=night_notes.json
DRY_RUN=false
